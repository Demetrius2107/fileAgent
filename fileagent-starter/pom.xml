<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.demetrius</groupId>
        <artifactId>file-agent-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>fileagent-starter</artifactId>
    <name>fileagent-starter</name>
    <description>启动装配：唯一 Spring Boot 入口，聚合各域 Bean</description>

    <dependencies>
        <!-- 聚合全部业务域 -->
        <dependency>
            <groupId>com.demetrius</groupId>
            <artifactId>fileagent-session</artifactId>
        </dependency>
        <dependency>
            <groupId>com.demetrius</groupId>
            <artifactId>fileagent-document</artifactId>
        </dependency>
        <dependency>
            <groupId>com.demetrius</groupId>
            <artifactId>fileagent-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>com.demetrius</groupId>
            <artifactId>fileagent-action</artifactId>
        </dependency>

        <!-- 运行时 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
